{
  "name": "anonymous-campus-confession",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "dev:fast": "next dev --turbo --experimental-https",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "next lint --fix",
    "type-check": "tsc --noEmit --incremental",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "echo \"No tests specified\" && exit 0",
    "deploy": "vercel --prod",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "clean": "rm -rf .next && rm -rf node_modules/.cache",
    "clear-limits": "node clear-rate-limits.js"
  },
  "dependencies": {
    "@auth/pg-adapter": "^1.11.1",
    "autoprefixer": "^10.4.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.2.3",
    "jsonwebtoken": "^9.0.3",
    "next": "14.0.0",
    "next-auth": "^4.24.13",
    "pg": "^8.11.3",
    "postcss": "^8.4.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwindcss": "^3.3.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "20.0.0",
    "@types/pg": "^8.10.0",
    "@types/react": "18.2.0",
    "@types/react-dom": "18.2.0",
    "@types/sqlite3": "^3.1.8",
    "@types/uuid": "^9.0.2",
    "eslint": "8.0.0",
    "eslint-config-next": "14.0.0",
    "typescript": "^5.3.0"
  }
}
